# Build artifacts
bin/
obj/
*.exe

# IDE/editor noise
.idea/
.vscode/
*.swp
*.swo

# Local env files (must never be baked into images), at any depth: a pattern
# without **/ matches only at the root of the build context.
.env
.env.*
**/.env
**/.env.*

# Git metadata
.git/
.gitignore

# Docker metadata (avoid recursion)
Dockerfile
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# Documentation
README.md
*.md

# OS junk
.DS_Store
Thumbs.db
